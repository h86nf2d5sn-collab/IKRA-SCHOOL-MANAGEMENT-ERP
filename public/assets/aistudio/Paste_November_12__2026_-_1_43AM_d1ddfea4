        // --- FULL LEDGERS & AUDIT ---
        function renderFullLedgers() {
            const tbody = document.getElementById('ledgersTableBody');
            if (!tbody) return;

            // Group transactions by month
            const monthMap = {};
            transactions.forEach(t => {
                const monthKey = t.date ? t.date.substring(0, 7) : '2026-01';
                if (!monthMap[monthKey]) {
                    monthMap[monthKey] = { income: 0, expense: 0 };
                }
                if (t.type === 'Income') monthMap[monthKey].income += parseFloat(t.amount) || 0;
                else if (t.type === 'Expense') monthMap[monthKey].expense += parseFloat(t.amount) || 0;
            });

            const months = Object.keys(monthMap).sort().reverse();
            tbody.innerHTML = months.length === 0 ? `<tr><td colspan="4" class="p-4 text-center text-slate-500 font-extrabold">No financial transactions recorded.</td></tr>` :
                months.map(m => {
                    const inc = monthMap[m].income;
                    const exp = monthMap[m].expense;
                    const net = inc - exp;
                    return `
                        <tr class="hover:bg-blue-50 border-b border-blue-200">
                            <td class="p-3 font-black text-blue-950 border-r-2 border-blue-600">${m}</td>
                            <td class="p-3 font-bold text-emerald-700 border-r-2 border-blue-600">৳ ${inc.toLocaleString()}</td>
                            <td class="p-3 font-bold text-rose-700 border-r-2 border-blue-600">৳ ${exp.toLocaleString()}</td>
                            <td class="p-3 text-right font-black ${net >= 0 ? 'text-emerald-700' : 'text-rose-700'}">৳ ${net.toLocaleString()}</td>
                        </tr>
                    `;
                }).join('');
        }

        // --- JSON DATABASE BACKUP & RESTORE ---
        function exportDatabaseJSON() {
            const db = { students, teachers, staff, feeCategories, feePresets, costCategories, transactions, classSubjects, examMarks, routineSlots };
            const jsonStr = JSON.stringify(db, null, 2);
            const blob = new Blob([jsonStr], { type: 'application/json' });
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.setAttribute('download', `IKRA_ERP_Backup_${new Date().toISOString().split('T')[0]}.json`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        function importDatabaseJSON(e) {
            const file = e.target.files[0]; if (!file) return;
            const reader = new FileReader();
            reader.onload = function(ev) {
                try {
                    const db = JSON.parse(ev.target.result);
                    if (db.students) students = db.students;
                    if (db.teachers) teachers = db.teachers;
                    if (db.staff) staff = db.staff;
                    if (db.feeCategories) feeCategories = db.feeCategories;
                    if (db.feePresets) feePresets = db.feePresets;
                    if (db.costCategories) costCategories = db.costCategories;
                    if (db.transactions) transactions = db.transactions;
                    if (db.classSubjects) classSubjects = db.classSubjects;
                    if (db.examMarks) examMarks = db.examMarks;
                    if (db.routineSlots) routineSlots = db.routineSlots;
                    saveData();
                    switchTab('dashboard');
                    alert('Database restored successfully from backup!');
                } catch (err) {
                    alert('Failed to parse database backup JSON file.');
                }
            };
            reader.readAsText(file);
        }

