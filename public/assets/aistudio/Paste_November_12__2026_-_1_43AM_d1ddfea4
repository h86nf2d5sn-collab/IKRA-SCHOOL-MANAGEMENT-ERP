        function handleRoutineSubmit(e) {
            e.preventDefault();
            const cls = document.getElementById('routineClassSelect').value;
            const day = document.getElementById('rtnDay').value;
            const time = document.getElementById('rtnTime').value.trim();
            const period = parseInt(document.getElementById('rtnSlotPeriodIdx').value) || 1;
            const subject = document.getElementById('rtnSubject').value.trim();
            const teacher = document.getElementById('rtnTeacher').value;

            if (!time || !subject) return;

            // Remove existing slot for that day/period if replacing
            routineSlots = routineSlots.filter(r => !(r.className === cls && r.day === day && (r.period === period || r.time === time)));

            routineSlots.push({ className: cls, day, period, time, subject, teacher });
            saveData();
            closeRoutineModal();
            renderWeeklyRoutineGrid();
        }

        function deleteSingleRoutineSlot(cls, day, indexInDay) {
            let dayCount = 0;
            const globalIndex = routineSlots.findIndex(r => {
                if (r.className === cls && r.day === day) {
                    if (dayCount === indexInDay) return true;
                    dayCount++;
                }
                return false;
