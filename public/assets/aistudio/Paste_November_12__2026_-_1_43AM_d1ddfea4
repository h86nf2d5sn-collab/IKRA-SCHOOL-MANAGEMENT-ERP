        // --- GPA & LETTER GRADE CALCULATION ENGINE ---
        function calculateSubjectGP(marks) {
            const val = parseFloat(marks) || 0;
            if (val >= 80) return { gp: 5.00, grade: 'A+' };
            if (val >= 70) return { gp: 4.00, grade: 'A' };
            if (val >= 60) return { gp: 3.50, grade: 'A-' };
            if (val >= 50) return { gp: 3.00, grade: 'B' };
            if (val >= 40) return { gp: 2.00, grade: 'C' };
            if (val >= 33) return { gp: 1.00, grade: 'D' };
            return { gp: 0.00, grade: 'F' };
        }

        function calculateOverallGPA(subjectMarksList) {
            if (!subjectMarksList || subjectMarksList.length === 0) {
                return { gpa: '3.50', grade: 'A-', totalMarks: 0, failedCount: 0 };
            }

            let totalGP = 0;
            let totalMarks = 0;
            let failedCount = 0;

            subjectMarksList.forEach(m => {
                const subTotal = parseFloat(m.total) || 0;
                totalMarks += subTotal;

                const { gp } = calculateSubjectGP(subTotal);
                if (gp === 0.00) {
                    failedCount++;
                }
                totalGP += gp;
            });

            if (failedCount > 0) {
                return { gpa: '0.00', grade: 'F', totalMarks, failedCount };
            }

            const avgGP = totalGP / subjectMarksList.length;
            let overallGrade = 'F';

            if (avgGP >= 5.00) overallGrade = 'A+';
            else if (avgGP >= 4.00) overallGrade = 'A';
            else if (avgGP >= 3.50) overallGrade = 'A-';
            else if (avgGP >= 3.00) overallGrade = 'B';
            else if (avgGP >= 2.00) overallGrade = 'C';
            else if (avgGP >= 1.00) overallGrade = 'D';

            return {
                gpa: avgGP.toFixed(2),
                grade: overallGrade,
                totalMarks,
                failedCount: 0
            };
        }

        function calculateStudentGPA(stuId) {
            const marks = examMarks.filter(m => m.stuId === stuId);
            const result = calculateOverallGPA(marks);
            return parseFloat(result.gpa);
        }

