        function handleMarksSubmit(e) {
            e.preventDefault();
            const term = document.getElementById('examTermSelect').value;
            const cls = document.getElementById('examClassSelect').value;
            const stuId = document.getElementById('examStudentSelect').value;

            const student = students.find(s => s.id === stuId);
            if (!student) { alert('Please select a student.'); return; }

            const rows = document.querySelectorAll('.exam-subject-row');
            if (rows.length === 0) { alert('Please add at least one subject row.'); return; }

            // Clear previous marks for student in this term to allow update
            examMarks = examMarks.filter(m => !(m.stuId === stuId && m.term === term));

            let count = 0;
            rows.forEach(row => {
                const subject = row.querySelector('.exam-sub-sel').value;
                const written = parseFloat(row.querySelector('.exam-written-input').value) || 0;
                const mcq = parseFloat(row.querySelector('.exam-mcq-input').value) || 0;
                const total = written + mcq;

                examMarks.push({
                    id: 'MRK-' + (Date.now() + Math.random()),
                    term, cls, stuId, studentName: student.name, roll: student.roll,
                    subject, written, mcq, total
                });
                count++;
            });

            saveData();
            alert(`${count} subject mark record(s) saved for ${student.name} (${term})!`);
            renderModelTestLeaderboard();
        }

        function renderModelTestLeaderboard() {
            const cls = document.getElementById('examClassSelect')?.value || 'Class 9 Science Group';
            const term = document.getElementById('examTermSelect')?.value || 'Final Term Exam';
            const tbody = document.getElementById('leaderboardTableBody');
            const badge = document.getElementById('leaderboardTermBadge');
            
            if (badge) badge.innerText = `${cls} - ${term}`;
            if (!tbody) return;

            // Filter exam marks by class and term
            const filteredMarks = examMarks.filter(m => (m.cls === cls || !m.cls) && m.term === term);
            
            // Group subject marks by student
            const studentMarksMap = {};
            filteredMarks.forEach(m => {
                if (!studentMarksMap[m.stuId]) {
                    studentMarksMap[m.stuId] = {
                        stuId: m.stuId,
                        name: m.studentName || 'Student',
                        roll: m.roll || '-',
                        subjects: []
                    };
                }
                studentMarksMap[m.stuId].subjects.push(m);
            });

            // Calculate exact board GPA for each student
            const leaderboard = Object.values(studentMarksMap).map(stu => {
                const evalRes = calculateOverallGPA(stu.subjects);
                return {
                    stuId: stu.stuId,
                    name: stu.name,
                    roll: stu.roll,
                    totalMarks: evalRes.totalMarks,
                    gpa: evalRes.gpa,
                    grade: evalRes.grade,
                    failedCount: evalRes.failedCount
                };
            }).sort((a, b) => {
                if (parseFloat(b.gpa) !== parseFloat(a.gpa)) {
                    return parseFloat(b.gpa) - parseFloat(a.gpa);
                }
                return b.totalMarks - a.totalMarks;
            });

            tbody.innerHTML = leaderboard.length === 0 ? 
                `<tr><td colspan="6" class="p-4 text-center text-slate-500 font-extrabold">No exam marks recorded for ${cls} (${term}).</td></tr>` :
                leaderboard.map((item, idx) => {
                    const isPassed = item.grade !== 'F';
                    const gradeBadge = isPassed ? 
                        `<span class="bg-emerald-100 text-emerald-950 border border-emerald-600 px-2.5 py-0.5 rounded text-xs font-black">${item.grade} (${item.gpa})</span>` :
                        `<span class="bg-rose-100 text-rose-950 border border-rose-600 px-2.5 py-0.5 rounded text-xs font-black">F (GPA 0.00)</span>`;

                    return `
                        <tr class="hover:bg-blue-50 border-b border-blue-200">
                            <td class="p-3 font-black text-blue-950 border-r-2 border-blue-600">#${idx + 1}</td>
                            <td class="p-3 font-bold text-slate-900 border-r-2 border-blue-600">${item.roll}</td>
                            <td class="p-3 font-extrabold text-blue-950 border-r-2 border-blue-600">${item.name}</td>
                            <td class="p-3 font-black text-emerald-700 border-r-2 border-blue-600 text-center">${item.totalMarks}</td>
                            <td class="p-3 font-black border-r-2 border-blue-600 text-center ${isPassed ? 'text-blue-950' : 'text-rose-700'}">${item.gpa}</td>
                            <td class="p-3 text-center">${gradeBadge}</td>
                        </tr>
                    `;
                }).join('');
        }

