        function openBoxRoutineModal(cls, day, period, defaultTime) {
            document.getElementById('rtnDay').value = day;
            document.getElementById('rtnTime').value = `Period ${period} (${defaultTime})`;
            document.getElementById('rtnSlotPeriodIdx').value = period;
            document.getElementById('routineModalTitle').innerText = `Set Routine: ${cls} - ${day}`;

            // Reset teacher dropdown options
            const tchSel = document.getElementById('rtnTeacher');
            if (tchSel) {
                tchSel.innerHTML = teachers.map(t => `<option value="${t.name}">${t.name} (${t.subject || 'General'})</option>`).join('');
            }

            // Populate existing values if slot exists
            const slot = routineSlots.find(r => r.className === cls && r.day === day && (r.period === period || r.time === `Period ${period} (${defaultTime})`));
            if (slot) {
                document.getElementById('rtnSubject').value = slot.subject || '';
                if (tchSel && slot.teacher) tchSel.value = slot.teacher;
                document.getElementById('btnClearSlot').classList.remove('hidden');
            } else {
                document.getElementById('rtnSubject').value = '';
                document.getElementById('btnClearSlot').classList.add('hidden');
