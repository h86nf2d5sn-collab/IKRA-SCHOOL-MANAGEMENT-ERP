<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IKRA School & College - ERP Management Solution</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="style.css">
</head>
<body class="bg-slate-100 text-slate-900 min-h-screen flex flex-col font-sans">

    <!-- TOP BAR -->
    <header class="no-print bg-blue-950 text-white border-b-2 border-black sticky top-0 z-40 shadow-md">
        <div class="max-w-7xl mx-auto px-4 py-3 flex justify-between items-center">
            <div class="flex items-center space-x-3">
                <div class="bg-blue-600 text-white font-black px-3 py-1.5 rounded-lg border-2 border-white shadow">IKRA</div>
                <div>
                    <h1 class="font-extrabold text-base tracking-tight leading-none text-white">IKRA SCHOOL & COLLEGE</h1>
                    <p class="text-xs text-blue-300 font-bold mt-0.5">Comprehensive ERP & Portal System</p>
                </div>
            </div>
            <div class="flex items-center space-x-2">
                <button onclick="exportDatabaseJSON()" class="bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-black px-3 py-1.5 rounded-lg border-2 border-black transition shadow">💾 Backup DB</button>
                <label class="bg-blue-700 hover:bg-blue-800 text-white text-xs font-black px-3 py-1.5 rounded-lg border-2 border-black cursor-pointer transition shadow">
                    📂 Restore DB <input type="file" accept=".json" class="hidden" onchange="importDatabaseJSON(event)">
                </label>
            </div>
        </div>
    </header>

    <!-- MAIN WRAPPER -->
    <div class="flex-1 max-w-7xl w-full mx-auto p-4 flex flex-col md:flex-row gap-6">

        <!-- SIDEBAR NAVIGATION -->
        <aside class="no-print md:w-64 flex-shrink-0 space-y-4">
            <div class="bg-white border-2 border-blue-600 rounded-2xl p-4 shadow-sm space-y-2">
                <p class="text-xs font-black text-blue-950 uppercase tracking-wider px-2 mb-2">Main Navigation</p>

                <!-- 1. Dashboard -->
                <button id="nav-dashboard" onclick="switchTab('dashboard')" class="sidebar-btn w-full text-left px-3 py-2 rounded-xl text-xs font-extrabold transition border-2 border-black flex items-center justify-between bg-blue-600 text-white">
                    <span>+ Dashboard Overview</span>
                </button>

                <!-- 2. Settings & Categories -->
                <button id="nav-settings" onclick="switchTab('settings')" class="sidebar-btn w-full text-left px-3 py-2 rounded-xl text-xs font-extrabold transition border-2 border-black flex items-center justify-between bg-blue-50 text-blue-950 hover:bg-blue-100">
                    <span>+ Settings & Categories</span>
                </button>

                <!-- 3. Class-Wise Subject Setup -->
                <button id="nav-subjects" onclick="switchTab('subjects')" class="sidebar-btn w-full text-left px-3 py-2 rounded-xl text-xs font-extrabold transition border-2 border-black flex items-center justify-between bg-blue-50 text-blue-950 hover:bg-blue-100">
                    <span>+ Class Subject Setup</span>
                </button>

                <!-- 4. Cash Flow & Statements -->
                <button id="nav-cashflow" onclick="switchTab('cashflow')" class="sidebar-btn w-full text-left px-3 py-2 rounded-xl text-xs font-extrabold transition border-2 border-black flex items-center justify-between bg-blue-50 text-blue-950 hover:bg-blue-100">
                    <span>+ Cash Flow & Statements</span>
                </button>

                <p class="text-xs font-black text-blue-950 uppercase tracking-wider px-2 pt-3 mb-2">Students & Admissions</p>

                <!-- 5. Student Admission -->
                <button id="nav-admission" onclick="switchTab('admission')" class="sidebar-btn w-full text-left px-3 py-2 rounded-xl text-xs font-extrabold transition border-2 border-black flex items-center justify-between bg-blue-50 text-blue-950 hover:bg-blue-100">
                    <span>+ Student Admission</span>
                </button>

                <!-- 6. Student Progress & Promotion -->
                <button id="nav-promotion" onclick="switchTab('promotion')" class="sidebar-btn w-full text-left px-3 py-2 rounded-xl text-xs font-extrabold transition border-2 border-black flex items-center justify-between bg-blue-50 text-blue-950 hover:bg-blue-100">
                    <span>+ Auto Progress & Promotion</span>
                </button>

                <!-- 7. Students Directory & CSV -->
                <button id="nav-students" onclick="switchTab('students')" class="sidebar-btn w-full text-left px-3 py-2 rounded-xl text-xs font-extrabold transition border-2 border-black flex items-center justify-between bg-blue-50 text-blue-950 hover:bg-blue-100">
                    <span>+ Students Directory & CSV</span>
                </button>

                <p class="text-xs font-black text-blue-950 uppercase tracking-wider px-2 pt-3 mb-2">Staff & Roster</p>

                <!-- 8. Teachers Roster & CSV -->
                <button id="nav-teachers" onclick="switchTab('teachers')" class="sidebar-btn w-full text-left px-3 py-2 rounded-xl text-xs font-extrabold transition border-2 border-black flex items-center justify-between bg-blue-50 text-blue-950 hover:bg-blue-100">
                    <span>+ Teachers Roster & CSV</span>
                </button>

                <!-- 9. Staff Directory & CSV -->
                <button id="nav-staff" onclick="switchTab('staff')" class="sidebar-btn w-full text-left px-3 py-2 rounded-xl text-xs font-extrabold transition border-2 border-black flex items-center justify-between bg-blue-50 text-blue-950 hover:bg-blue-100">
                    <span>+ Staff Directory & CSV</span>
                </button>

                <p class="text-xs font-black text-blue-950 uppercase tracking-wider px-2 pt-3 mb-2">Academics & Operations</p>

                <!-- 10. Student ID Cards Generator -->
                <button id="nav-idcards" onclick="switchTab('idcards')" class="sidebar-btn w-full text-left px-3 py-2 rounded-xl text-xs font-extrabold transition border-2 border-black flex items-center justify-between bg-blue-50 text-blue-950 hover:bg-blue-100">
                    <span>+ ID Card Engine</span>
                </button>

                <!-- 11. Weekly Class Routines -->
                <button id="nav-routines" onclick="switchTab('routines')" class="sidebar-btn w-full text-left px-3 py-2 rounded-xl text-xs font-extrabold transition border-2 border-black flex items-center justify-between bg-blue-50 text-blue-950 hover:bg-blue-100">
                    <span>+ Weekly Class Routines</span>
                </button>

                <!-- 12. Class Rosters -->
                <button id="nav-classes" onclick="switchTab('classes')" class="sidebar-btn w-full text-left px-3 py-2 rounded-xl text-xs font-extrabold transition border-2 border-black flex items-center justify-between bg-blue-50 text-blue-950 hover:bg-blue-100">
                    <span>+ Class Rosters & Lists</span>
                </button>

                <p class="text-xs font-black text-blue-950 uppercase tracking-wider px-2 pt-3 mb-2">Finance & Exams</p>

                <!-- 13. Fee Collection & Receipts -->
                <button id="nav-payments" onclick="switchTab('payments')" class="sidebar-btn w-full text-left px-3 py-2 rounded-xl text-xs font-extrabold transition border-2 border-black flex items-center justify-between bg-blue-50 text-blue-950 hover:bg-blue-100">
                    <span>+ Fee Collection & Receipts</span>
                </button>

                <!-- 14. Fee Dues Tracker -->
                <button id="nav-dues" onclick="switchTab('dues')" class="sidebar-btn w-full text-left px-3 py-2 rounded-xl text-xs font-extrabold transition border-2 border-black flex items-center justify-between bg-blue-50 text-blue-950 hover:bg-blue-100">
                    <span>+ Fee Dues Tracker</span>
                </button>

                <!-- 15. Exam & Model Test Engine -->
                <button id="nav-modeltest" onclick="switchTab('modeltest')" class="sidebar-btn w-full text-left px-3 py-2 rounded-xl text-xs font-extrabold transition border-2 border-black flex items-center justify-between bg-blue-50 text-blue-950 hover:bg-blue-100">
                    <span>+ Exam & Marksheet Engine</span>
                </button>

                <!-- 16. Expense & Salary Outflow -->
                <button id="nav-expenses" onclick="switchTab('expenses')" class="sidebar-btn w-full text-left px-3 py-2 rounded-xl text-xs font-extrabold transition border-2 border-black flex items-center justify-between bg-blue-50 text-blue-950 hover:bg-blue-100">
                    <span>+ Expense & Salary Outflow</span>
                </button>

                <!-- 17. Certificates & Testimonials -->
                <button id="nav-certificates" onclick="switchTab('certificates')" class="sidebar-btn w-full text-left px-3 py-2 rounded-xl text-xs font-extrabold transition border-2 border-black flex items-center justify-between bg-blue-50 text-blue-950 hover:bg-blue-100">
                    <span>+ Certificates & Testimonials</span>
                </button>

                <!-- 18. Full Ledgers & Audit -->
                <button id="nav-ledgers" onclick="switchTab('ledgers')" class="sidebar-btn w-full text-left px-3 py-2 rounded-xl text-xs font-extrabold transition border-2 border-black flex items-center justify-between bg-blue-50 text-blue-950 hover:bg-blue-100">
                    <span>+ Full Audit Ledgers</span>
                </button>
            </div>
        </aside>

        <!-- MAIN DISPLAY AREA -->
        <main class="flex-1 min-w-0">

            <!-- 1. DASHBOARD OVERVIEW TAB -->
            <section id="tab-dashboard" class="tab-content space-y-6">
                <div class="border-b-2 border-black pb-4">
                    <h2 class="text-2xl font-extrabold text-blue-950 tracking-tight">Institutional Dashboard Summary</h2>
                    <p class="text-sm text-slate-700 font-bold">Real-time stats across students, academic staff, and finances.</p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                    <div class="bg-white border-2 border-blue-600 rounded-xl p-4 shadow-sm">
                        <p class="text-xs font-bold text-slate-600 uppercase">Total Students</p>
                        <h3 class="text-2xl font-black text-blue-950 mt-1" id="dashTotalStudents">0</h3>
                        <p class="text-xs text-emerald-700 font-bold mt-1">Active Enrollment</p>
                    </div>
                    <div class="bg-white border-2 border-blue-600 rounded-xl p-4 shadow-sm">
                        <p class="text-xs font-bold text-slate-600 uppercase">Total Faculty & Staff</p>
                        <h3 class="text-2xl font-black text-blue-950 mt-1" id="dashTotalStaff">0</h3>
                        <p class="text-xs text-blue-700 font-bold mt-1">Teachers & Staff</p>
                    </div>
                    <div class="bg-white border-2 border-blue-600 rounded-xl p-4 shadow-sm">
                        <p class="text-xs font-bold text-slate-600 uppercase">Total Inflows (Income)</p>
                        <h3 class="text-2xl font-black text-emerald-700 mt-1" id="dashTotalIncome">৳ 0</h3>
                        <p class="text-xs text-slate-600 font-bold mt-1">Fees & Collections</p>
                    </div>
                    <div class="bg-white border-2 border-blue-600 rounded-xl p-4 shadow-sm">
                        <p class="text-xs font-bold text-slate-600 uppercase">Total Outflows (Expense)</p>
                        <h3 class="text-2xl font-black text-rose-700 mt-1" id="dashTotalExpense">৳ 0</h3>
                        <p class="text-xs text-slate-600 font-bold mt-1">Salaries & Costs</p>
                    </div>
                </div>

                <div class="bg-white border-2 border-blue-600 rounded-xl p-5 space-y-4 shadow-sm">
                    <h3 class="font-extrabold text-blue-950 text-base">Quick Operational Actions</h3>
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                        <button onclick="switchTab('admission')" class="bg-blue-50 hover:bg-blue-100 text-blue-950 border-2 border-blue-600 p-3 rounded-lg text-xs font-extrabold text-center transition">➕ Add Admission</button>
                        <button onclick="switchTab('payments')" class="bg-emerald-50 hover:bg-emerald-100 text-emerald-950 border-2 border-emerald-600 p-3 rounded-lg text-xs font-extrabold text-center transition">🧾 Collect Fees</button>
                        <button onclick="switchTab('expenses')" class="bg-rose-50 hover:bg-rose-100 text-rose-950 border-2 border-rose-600 p-3 rounded-lg text-xs font-extrabold text-center transition">💸 Record Expense</button>
                        <button onclick="switchTab('idcards')" class="bg-amber-50 hover:bg-amber-100 text-amber-950 border-2 border-amber-600 p-3 rounded-lg text-xs font-extrabold text-center transition">🎴 ID Cards</button>
                    </div>
                </div>
            </section>

            <!-- 2. SETTINGS & CATEGORIES TAB -->
            <section id="tab-settings" class="tab-content hidden space-y-6">
                <div class="border-b-2 border-black pb-4">
                    <h2 class="text-2xl font-extrabold text-blue-950 tracking-tight">Settings & Financial Categories</h2>
                    <p class="text-sm text-slate-700 font-bold">Manage system presets, custom fee heads, and expense categories.</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <!-- Fee Heads -->
                    <div class="bg-white border-2 border-blue-600 rounded-xl p-5 space-y-4 shadow-sm">
                        <div class="flex justify-between items-center border-b-2 border-blue-600 pb-2">
                            <h3 class="font-extrabold text-blue-950 text-sm">Fee Categories</h3>
                            <button onclick="resetDefaultFeeCategories()" class="text-xs text-blue-700 font-extrabold hover:underline">Reset Defaults</button>
                        </div>
                        <div class="flex gap-2">
                            <input type="text" id="newFeeCatInput" placeholder="New Fee Head..." class="flex-1 px-3 py-1.5 border-2 border-blue-600 bg-white rounded-lg text-xs font-bold text-slate-900 outline-none">
                            <button onclick="addCustomFeeCategory()" class="bg-blue-600 text-white px-3 py-1.5 rounded-lg text-xs font-extrabold border-2 border-black">Add</button>
                        </div>
                        <div id="feeCategoriesList" class="space-y-2 max-h-60 overflow-y-auto"></div>
                    </div>

                    <!-- Fee Amounts Presets -->
                    <div class="bg-white border-2 border-blue-600 rounded-xl p-5 space-y-4 shadow-sm">
                        <div class="border-b-2 border-blue-600 pb-2">
                            <h3 class="font-extrabold text-blue-950 text-sm">Default Fee Amounts (BDT)</h3>
                        </div>
                        <div id="feePresetsConfigList" class="space-y-2 max-h-64 overflow-y-auto"></div>
                    </div>

                    <!-- Cost Categories -->
                    <div class="bg-white border-2 border-blue-600 rounded-xl p-5 space-y-4 shadow-sm">
                        <div class="flex justify-between items-center border-b-2 border-blue-600 pb-2">
                            <h3 class="font-extrabold text-blue-950 text-sm">Cost / Expense Heads</h3>
                            <button onclick="resetDefaultCostCategories()" class="text-xs text-blue-700 font-extrabold hover:underline">Reset Defaults</button>
                        </div>
                        <div class="flex gap-2">
                            <input type="text" id="newCostCatInput" placeholder="New Expense Head..." class="flex-1 px-3 py-1.5 border-2 border-blue-600 bg-white rounded-lg text-xs font-bold text-slate-900 outline-none">
                            <button onclick="addCustomCostCategory()" class="bg-blue-600 text-white px-3 py-1.5 rounded-lg text-xs font-extrabold border-2 border-black">Add</button>
                        </div>
                        <div id="costCategoriesList" class="space-y-2 max-h-60 overflow-y-auto"></div>
                    </div>
                </div>
            </section>

            <!-- 3. CLASS-WISE SUBJECT SETUP TAB -->
            <section id="tab-subjects" class="tab-content hidden space-y-6">
                <div class="border-b-2 border-black pb-4">
                    <h2 class="text-2xl font-extrabold text-blue-950 tracking-tight">Class-Wise Subject Setup</h2>
                    <p class="text-sm text-slate-700 font-bold">Define subjects and elective groups for each academic grade and stream.</p>
                </div>

                <div class="bg-white border-2 border-blue-600 rounded-xl p-5 space-y-4 shadow-sm">
                    <div class="flex flex-wrap justify-between items-center gap-4">
                        <div class="flex items-center gap-3">
                            <label class="text-xs font-bold text-blue-950">Select Class Level:</label>
                            <select id="subjectClassSelect" onchange="renderSubjectPresetList()" class="px-3 py-1.5 border-2 border-blue-600 bg-white rounded-lg text-xs font-bold text-slate-900 outline-none">
                                <option value="Class 1">Class 1</option>
                                <option value="Class 2">Class 2</option>
                                <option value="Class 3">Class 3</option>
                                <option value="Class 4">Class 4</option>
                                <option value="Class 5">Class 5</option>
                                <option value="Class 6">Class 6</option>
                                <option value="Class 7">Class 7</option>
                                <option value="Class 8">Class 8</option>
                                <option value="Class 9 Science Group" selected>Class 9 Science Group</option>
                                <option value="Class 9 Arts Group">Class 9 Arts Group</option>
                                <option value="Class 9 Commerce Group">Class 9 Commerce Group</option>
                                <option value="10th Class Science Group">10th Class Science Group</option>
                                <option value="10th Class Arts Group">10th Class Arts Group</option>
                                <option value="10th Class Commerce Group">10th Class Commerce Group</option>
                                <option value="HSC -XI Science group">HSC -XI Science group</option>
                                <option value="HSC -XI arts group">HSC -XI arts group</option>
                                <option value="HSC -XI commerce group">HSC -XI commerce group</option>
                                <option value="HSC -XII Science group">HSC -XII Science group</option>
                                <option value="HSC -XII arts group">HSC -XII arts group</option>
                                <option value="HSC -XII commerce group">HSC -XII commerce group</option>
                            </select>
                        </div>
                        <button onclick="openAddNewSubjectModal()" class="bg-emerald-600 hover:bg-emerald-700 text-white px-3 py-1.5 rounded-lg text-xs font-extrabold border-2 border-black transition shadow">➕ Add New Subject</button>
                    </div>

                    <div class="overflow-x-auto bg-blue-600 rounded-xl border-2 border-white shadow-sm">
                        <table class="w-full text-left text-xs border-collapse">
                            <thead>
                                <tr class="bg-blue-900 text-white border-b-2 border-white uppercase tracking-wider font-extrabold">
                                    <th class="p-3 border-r-2 border-white">#</th>
                                    <th class="p-3 border-r-2 border-white">Subject Title</th>
                                    <th class="p-3 border-r-2 border-white">Group / Type</th>
                                    <th class="p-3 text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="subjectPresetTableBody" class="divide-y-2 divide-white text-white font-extrabold">
                                <!-- Injected -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <!-- 4. CASH FLOW & STATEMENTS TAB -->
            <section id="tab-cashflow" class="tab-content hidden space-y-6">
                <div class="border-b-2 border-black pb-4">
                    <h2 class="text-2xl font-extrabold text-blue-950 tracking-tight">Cash Flow & Statements</h2>
                    <p class="text-sm text-slate-700 font-bold">Monitor incoming fee payments and outgoing institutional costs.</p>
                </div>

                <div class="overflow-x-auto bg-white rounded-xl border-2 border-blue-600 shadow-sm">
                    <table class="w-full text-left text-xs border-collapse">
                        <thead>
                            <tr class="bg-blue-900 text-white border-b-2 border-blue-600 uppercase tracking-wider font-extrabold">
                                <th class="p-3 border-r-2 border-blue-600">Date</th>
                                <th class="p-3 border-r-2 border-blue-600">Type</th>
                                <th class="p-3 border-r-2 border-blue-600">Category</th>
                                <th class="p-3 border-r-2 border-blue-600">Payee / Payer</th>
                                <th class="p-3 text-right">Amount (BDT)</th>
                            </tr>
                        </thead>
                        <tbody id="cashFlowTableBody" class="divide-y-2 divide-blue-600 bg-white font-bold text-slate-900">
                            <!-- Injected -->
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- 5. STUDENT ADMISSION TAB -->
            <section id="tab-admission" class="tab-content hidden space-y-6">
                <div class="border-b-2 border-black pb-4">
                    <h2 class="text-2xl font-extrabold text-blue-950 tracking-tight">Student Admission Entry</h2>
                    <p class="text-sm text-slate-700 font-bold">Enroll new students with auto-incremented roll assignments.</p>
                </div>

                <div class="bg-blue-600 border-2 border-white rounded-xl p-6 shadow-sm text-white space-y-4">
                    <form onsubmit="handleAdmissionSubmit(event)" class="space-y-4">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs font-extrabold text-white mb-1">Student Full Name *</label>
                                <input type="text" id="admName" required class="w-full px-3 py-2 border-2 border-white bg-white text-slate-900 rounded-lg text-xs font-extrabold outline-none">
                            </div>
                            <div>
                                <label class="block text-xs font-extrabold text-white mb-1">Select Target Class *</label>
                                <select id="admClass" required class="w-full px-3 py-2 border-2 border-white bg-white text-slate-900 rounded-lg text-xs font-extrabold outline-none">
                                    <option value="Class 1">Class 1</option>
                                    <option value="Class 2">Class 2</option>
                                    <option value="Class 3">Class 3</option>
                                    <option value="Class 4">Class 4</option>
                                    <option value="Class 5">Class 5</option>
                                    <option value="Class 6">Class 6</option>
                                    <option value="Class 7">Class 7</option>
                                    <option value="Class 8">Class 8</option>
                                    <option value="Class 9 Science Group">Class 9 Science Group</option>
                                    <option value="Class 9 Arts Group">Class 9 Arts Group</option>
                                    <option value="Class 9 Commerce Group">Class 9 Commerce Group</option>
                                    <option value="10th Class Science Group" selected>10th Class Science Group</option>
                                    <option value="10th Class Arts Group">10th Class Arts Group</option>
                                    <option value="10th Class Commerce Group">10th Class Commerce Group</option>
                                    <option value="HSC -XI Science group">HSC -XI Science group</option>
                                    <option value="HSC -XI arts group">HSC -XI arts group</option>
                                    <option value="HSC -XI commerce group">HSC -XI commerce group</option>
                                    <option value="HSC -XII Science group">HSC -XII Science group</option>
                                    <option value="HSC -XII arts group">HSC -XII arts group</option>
                                    <option value="HSC -XII commerce group">HSC -XII commerce group</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-extrabold text-white mb-1">Stream / Group *</label>
                                <select id="admDept" class="w-full px-3 py-2 border-2 border-white bg-white text-slate-900 rounded-lg text-xs font-extrabold outline-none">
                                    <option value="Science">Science</option>
                                    <option value="Humanities/Arts">Humanities/Arts</option>
                                    <option value="Business Studies/Commerce">Business Studies/Commerce</option>
                                    <option value="General">General</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-extrabold text-white mb-1">Guardian Name *</label>
                                <input type="text" id="admGuardian" required class="w-full px-3 py-2 border-2 border-white bg-white text-slate-900 rounded-lg text-xs font-extrabold outline-none">
                            </div>
                            <div>
                                <label class="block text-xs font-extrabold text-white mb-1">Contact Mobile Number *</label>
                                <input type="text" id="admMobile" required class="w-full px-3 py-2 border-2 border-white bg-white text-slate-900 rounded-lg text-xs font-extrabold outline-none">
                            </div>
                            <div>
                                <label class="block text-xs font-extrabold text-white mb-1">Home Address</label>
                                <input type="text" id="admHomeAddr" class="w-full px-3 py-2 border-2 border-white bg-white text-slate-900 rounded-lg text-xs font-extrabold outline-none">
                            </div>
                        </div>
                        <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white py-3 rounded-lg font-black text-xs border-2 border-black transition shadow">Submit Admission</button>
                    </form>
                </div>
            </section>

            <!-- 6. STUDENT PROGRESS & PROMOTION TAB -->
            <section id="tab-promotion" class="tab-content hidden space-y-6">
                <div class="border-b-2 border-black pb-4 flex flex-wrap justify-between items-center gap-4">
                    <div>
                        <h2 class="text-2xl font-extrabold text-blue-950 tracking-tight">Auto Progress & Class Promotion Engine</h2>
                        <p class="text-sm text-slate-700 font-bold">Automated promotion engine driven by exam results, passing rules, and stream mapping.</p>
                    </div>
